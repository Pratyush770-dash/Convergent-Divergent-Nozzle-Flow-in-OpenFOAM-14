FoamFile
{
    format      ascii;
    class       polyBoundaryMesh;
    location    "constant/polyMesh";
    object      boundary;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

6
(
    inlet
    {
        type            patch;
        nFaces          20;
        startFace       5830;
    }
    outlet
    {
        type            patch;
        nFaces          20;
        startFace       5850;
    }
    wall
    {
        type            wall;
        inGroups        List<word> 1(wall);
        nFaces          150;
        startFace       5870;
    }
    front
    {
        type            wedge;
        inGroups        List<word> 1(wedge);
        nFaces          3000;
        startFace       6020;
    }
    back
    {
        type            wedge;
        inGroups        List<word> 1(wedge);
        nFaces          3000;
        startFace       9020;
    }
    defaultFaces
    {
        type            empty;
        inGroups        List<word> 1(empty);
        nFaces          0;
        startFace       12020;
    }
)

